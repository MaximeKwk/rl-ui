{
  "name": "rl-ui",
  "productName": "RL-UI",
  "version": "1.1.0",
  "description": "Stream overlay for Rocket League: wins / losses, MMR, victory / defeat / overtime alerts, caster mode.",
  "main": "electron/main.js",
  "author": "Zoxam",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/MaximeKwk/rl-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaximeKwk/rl-ui.git"
  },
  "bugs": {
    "url": "https://github.com/MaximeKwk/rl-ui/issues"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "headless": "node tools/headless.js",
    "sim": "node tools/simulator.js",
    "test": "node --test \"test/*.test.js\"",
    "e2e": "node tools/e2e.js",
    "icon": "electron tools/make-icon.js",
    "shot": "electron tools/shot.js",
    "dist": "electron-builder --win nsis portable",
    "dist:store": "electron-builder --win appx --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.2.6",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.zoxam.rlui",
    "productName": "RL-UI",
    "copyright": "© 2026 Zoxam",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "core/**/*",
      "web/**/*",
      "package.json",
      "LICENSE",
      "!**/*.map"
    ],
    "asar": true,
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "RL-UI"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RL-UI",
      "runAfterFinish": true,
      "artifactName": "RL-UI-Setup-${version}.${ext}",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "fr_FR"
      ]
    },
    "portable": {
      "artifactName": "RL-UI-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MaximeKwk",
        "repo": "rl-ui"
      }
    ],
    "appx": {
      "applicationId": "RLUI",
      "identityName": "Zoxam.RL-UI",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "Zoxam",
      "displayName": "RL-UI",
      "backgroundColor": "#0b1020",
      "languages": [
        "en-US",
        "fr-FR"
      ],
      "showNameOnTiles": false,
      "addAutoLaunchExtension": false,
      "artifactName": "RL-UI-Store-${version}.${ext}",
      "customExtensionsPath": "build/appx-extensions.xml",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  }
}
